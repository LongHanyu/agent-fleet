# Copy this file to config.local.env and chmod it 600.
# Never commit the populated file.

# Model gateway credential. The default API base is the shared CPU proxy.
RL_API_KEY=

# Required when RL_API_BASE points to http://10.100.184.46/v1. The launcher
# converts this value into the trusted MODEL_REQUEST_CONFIG_JSON X-Backend
# header. Leave it empty for a model endpoint that needs no routing header.
ROLLOUT_MODEL_BACKEND=

# YiCloud OpenSandbox API credentials.
YICLOUD_PUBLIC_KEY=
YICLOUD_SECRET_KEY=

# Optional deployment overrides.
# RL_API_BASE=https://maas.yicloud.com.cn/v1
# RL_MODEL_NAME=custom/model-id
# RL_DATASET_NAME=swe-rebench-v2
# RL_DATASET_ROOT=/workspace/path/to/Harbor-Dataset
# RL_MAX_CONCURRENT=16
# RL_WORKERS=16
# RL_PORT=19001
