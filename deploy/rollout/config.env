# Agent Fleet rollout service defaults for the shared CPU runner.
# Secrets and machine-specific model routing belong in config.local.env.

ROLLOUT=1
RUN_ID=agent-fleet-rollout
OUTPUT_ROOT=/data/agent-fleet-rollout/runs

AGENT=claude-code
RL_AGENT=claude-code
RL_HOST=0.0.0.0
RL_PORT=19001

# This path is the validated SWE-Rebench-V2 task subset on the shared volume.
# Point RL_DATASET_ROOT at a full Harbor-Dataset checkout when one is available.
RL_DATASET_NAME=swe-rebench-v2
RL_DATASET_ROOT=/workspace/sii-rl/datasets/swe-rebench-v2-new-20260826/Harbor-Dataset

RL_MODEL_NAME=m-20260809224233-cgvpw/glm-5.2-fp8
RL_API_BASE=http://10.100.184.46/v1
RL_API_KEY_MODE=static
RL_MODEL_INFO='{"max_input_tokens":24576,"max_output_tokens":8192}'
RL_MAX_NEW_TOKENS=8192
RL_MAX_TURNS=128
RL_LLM_TIMEOUT=900
RL_LLM_MAX_RETRIES=3
RL_REQUEST_TIMEOUT=14400
RL_COLLECT_ROLLOUT_DETAILS=true
RL_ENABLE_SUMMARIZE=false

# Start conservatively on a 49 GiB CPU host. Raise both values together only
# after checking available memory and OpenSandbox platform capacity.
RL_MAX_CONCURRENT=16
RL_WORKERS=16
HARBOR_MAX_RETRIES=0

RL_ENVIRONMENT_TYPE=opensandbox
AGENT_FLEET_REQUIRE_DOCKER=0
YICLOUD_API_HOST=https://gate.yicloud.com.cn
YICLOUD_PROJECT_NAME=fdj-infra
YICLOUD_SANDBOX_ENVIRONMENT_NAME=hanyu-agent-fleet
YICLOUD_SANDBOX_ENVIRONMENT_ID=env-528a0ebe-c94
YICLOUD_SANDBOX_PROXY_ORIGIN=https://gate.yicloud.com.cn/sandbox-connect
YICLOUD_SANDBOX_FAST_UPLOAD_ORIGIN=https://sandbox.yicloud.com.cn
YICLOUD_SANDBOX_LIFECYCLE_MINUTES=120
YICLOUD_SANDBOX_READY_TIMEOUT_SEC=900
YICLOUD_SANDBOX_STATUS_LOG_INTERVAL_SEC=30
YICLOUD_SANDBOX_RETAIN_ON_START_FAILURE=0
YICLOUD_SANDBOX_RETAIN_AFTER_TRIAL=0

YICLOUD_SANDBOX_UPLOAD_BACKEND=s3
YICLOUD_SANDBOX_S3_CONFIG=${HOME}/.s3cfg
YICLOUD_SANDBOX_S3_BUCKET=bucket-cache
YICLOUD_SANDBOX_S3_PREFIX=agent-fleet-upload/v1
YICLOUD_SANDBOX_S3_CACHE_ROOT=/data/agent-fleet-rollout/cache/opensandbox-s3
YICLOUD_SANDBOX_S3_LOCK_ROOT=/data/agent-fleet-rollout/cache/opensandbox-s3-locks
YICLOUD_SANDBOX_S3_SIGNED_URL_TTL_SEC=3600
YICLOUD_SANDBOX_S3_DOWNLOAD_TIMEOUT_SEC=1800
YICLOUD_SANDBOX_S3_DIRECTORY_COMPRESSION=auto

# Used only when a task does not already provide its OpenSandbox image.
YICLOUD_HARBOR_HOST=registry.gate.yicloud.com.cn
YICLOUD_HARBOR_PROJECT=fdj-infra
YICLOUD_HARBOR_TLS_VERIFY=0
HARBOR_OPENSANDBOX_BENCHMARK=swe-rebench-v2
HARBOR_OPENSANDBOX_IMAGE_CACHE_ROOT=/data/agent-fleet-rollout/cache/opensandbox-images

# Keep trace upload disabled. Local rollout details remain in RL_TRACE_LOG.
OPIK_URL=
HARBOR_CC_OPIK_ENABLE_HOOK=0

# Restricted-network package sources.
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
HARBOR_CC_NODE_DIST_URL=https://registry.npmmirror.com/-/binary/node/v22.14.0/node-v22.14.0-linux-x64.tar.gz

# The CPU runner cannot reach GitHub Releases directly. These URLs preserve the
# upstream artifacts and checksums while routing the download through a mirror
# that was verified from the target host.
UV_DOWNLOAD_URL=https://gh-proxy.com/https://github.com/astral-sh/uv/releases/download/0.11.28/uv-x86_64-unknown-linux-gnu.tar.gz
UV_CHECKSUM_URL=https://gh-proxy.com/https://github.com/astral-sh/uv/releases/download/0.11.28/uv-x86_64-unknown-linux-gnu.tar.gz.sha256
ZELLIJ_DOWNLOAD_URL=https://gh-proxy.com/https://github.com/zellij-org/zellij/releases/download/v0.44.3/zellij-x86_64-unknown-linux-musl.tar.gz
ZELLIJ_CHECKSUM_URL=https://gh-proxy.com/https://github.com/zellij-org/zellij/releases/download/v0.44.3/zellij-x86_64-unknown-linux-musl.sha256sum
